{
  "name": "reading-site-publishing",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit && tsc --project tsconfig.client.json --noEmit",
    "test": "node --test test/*.test.ts",
    "validate:data": "node scripts/validate-data.ts data",
    "build": "node scripts/build.ts && node scripts/validate-site.ts",
    "fixture": "node test/fixtures.ts .fixture-data",
    "build:fixture": "npm run fixture && DATA_DIR=.fixture-data SITE_URL=http://127.0.0.1:8080/ npm run build",
    "test:browser": "playwright test",
    "test:a11y": "playwright test test/browser/accessibility.spec.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fast-xml-parser": "^5.11.2",
    "parse5": "^8.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
